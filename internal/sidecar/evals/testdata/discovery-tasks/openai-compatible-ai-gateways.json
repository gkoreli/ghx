{
  "id": "openai-compatible-ai-gateways",
  "kind": "discovery",
  "turns": [
    "Which open-source repos provide a self-hostable AI gateway or proxy with OpenAI-compatible APIs?"
  ],
  "checks": {
    "targetRepos": [
      {
        "repo": "BerriAI/litellm",
        "requiredEvidence": ["README.md", "litellm/proxy/"],
        "famous": true,
        "aliases": ["LiteLLM"]
      },
      {
        "repo": "Portkey-AI/gateway",
        "requiredEvidence": ["README.md", "Dockerfile", "docker-compose.yaml"],
        "famous": true,
        "aliases": ["Portkey Gateway"]
      },
      {
        "repo": "Helicone/helicone",
        "requiredEvidence": ["README.md", "bifrost/"],
        "famous": true,
        "aliases": ["Helicone"]
      }
    ],
    "acceptableAlternates": [
      {
        "repo": "QuantumNous/new-api",
        "policy": "accepted-extra",
        "reason": "Cross-converts various LLMs into OpenAI-compatible formats with gateway and docker-compose self-hosting signals.",
        "aliases": ["new-api"]
      }
    ],
    "excludedRepos": [
      {
        "repo": "openai/openai-node",
        "reason": "Provider SDK, not a gateway/proxy."
      }
    ],
    "contaminationPaths": [
      "docs/adr/",
      "docs/evals/",
      "comparison",
      "benchmark"
    ]
  },
  "tags": ["discovery", "gateways", "openai-compatible"]
}
