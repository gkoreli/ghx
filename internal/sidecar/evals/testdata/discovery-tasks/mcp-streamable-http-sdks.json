{
  "id": "mcp-streamable-http-sdks",
  "kind": "discovery",
  "turns": [
    "Which official Model Context Protocol SDK repos expose Streamable HTTP transport support?"
  ],
  "checks": {
    "boundary": "Only official language SDK repos under github.com/modelcontextprotocol count as SDK repos; servers, inspector, registry, and spec repos do not.",
    "targetRepos": [
      {
        "repo": "modelcontextprotocol/typescript-sdk",
        "requiredEvidence": [
          "packages/client/src/client/streamableHttp.examples.ts",
          "packages/middleware/node/src/streamableHttp.ts"
        ],
        "famous": true,
        "aliases": ["TypeScript SDK"]
      },
      {
        "repo": "modelcontextprotocol/python-sdk",
        "requiredEvidence": ["examples/servers/simple-streamablehttp/mcp_simple_streamablehttp/server.py"],
        "famous": true,
        "aliases": ["Python SDK"]
      },
      {
        "repo": "modelcontextprotocol/go-sdk",
        "requiredEvidence": [
          "mcp/streamable.go",
          "mcp/streamable_server.go",
          "examples/"
        ],
        "famous": true,
        "aliases": ["Go SDK"]
      },
      {
        "repo": "modelcontextprotocol/java-sdk",
        "requiredEvidence": ["mcp-core/src/main/java/io/modelcontextprotocol/client/transport/HttpClientStreamableHttpTransport.java"],
        "famous": true,
        "aliases": ["Java SDK"]
      },
      {
        "repo": "modelcontextprotocol/csharp-sdk",
        "requiredEvidence": ["src/ModelContextProtocol.Core/Client/HttpTransportMode.cs"],
        "famous": true,
        "aliases": ["C# SDK", "CSharp SDK"]
      },
      {
        "repo": "modelcontextprotocol/kotlin-sdk",
        "requiredEvidence": ["KtorServer.kt"],
        "famous": true,
        "aliases": ["Kotlin SDK"]
      },
      {
        "repo": "modelcontextprotocol/rust-sdk",
        "requiredEvidence": ["examples/clients/src/streamable_http.rs"],
        "famous": true,
        "aliases": ["Rust SDK"]
      },
      {
        "repo": "modelcontextprotocol/php-sdk",
        "requiredEvidence": ["src/Server/Transport/StreamableHttpTransport.php"],
        "famous": true,
        "aliases": ["PHP SDK"]
      },
      {
        "repo": "modelcontextprotocol/ruby-sdk",
        "requiredEvidence": [
          "lib/mcp/server/transports/streamable_http_transport.rb",
          "examples/streamable_http_server.rb"
        ],
        "famous": true,
        "aliases": ["Ruby SDK"]
      },
      {
        "repo": "modelcontextprotocol/swift-sdk",
        "requiredEvidence": ["Sources/MCP/Base/Transports/HTTPClientTransport.swift"],
        "famous": true,
        "aliases": ["Swift SDK"]
      }
    ],
    "excludedRepos": [
      {
        "repo": "modelcontextprotocol/servers",
        "reason": "Official MCP repository, but not a language SDK repo."
      },
      {
        "repo": "modelcontextprotocol/inspector",
        "reason": "Official MCP tooling repository, but not a language SDK repo."
      },
      {
        "repo": "modelcontextprotocol/registry",
        "reason": "Official MCP registry repository, but not a language SDK repo."
      }
    ],
    "contaminationPaths": [
      "docs/adr/",
      "docs/evals/",
      "comparison",
      "benchmark"
    ]
  },
  "tags": ["discovery", "mcp", "streamable-http"]
}
