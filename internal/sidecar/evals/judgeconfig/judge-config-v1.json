{
  "schemaVersion": "judge-config-v1",
  "transport": "cli",
  "promptVersion": "judge-prompt-v1",
  "rubricVersion": "core-rubric-v1",
  "samples": 3,
  "maxPromptChars": 200000,
  "primary": {
    "provider": "openai",
    "model": "gpt-5.5",
    "maxOutputTokens": 8192,
    "cli": {
      "command": "codex",
      "args": ["exec", "--json", "-s", "read-only", "--output-last-message", "{output_file}", "-m", "{model}", "-"],
      "versionArgs": ["--version"],
      "extractLastCodexEvent": true,
      "outputLastMessage": true
    }
  },
  "secondary": {
    "provider": "anthropic",
    "model": "claude-opus-4-8",
    "maxOutputTokens": 4096,
    "cli": {
      "command": "claude",
      "args": ["-p", "--model", "{model}", "--output-format", "text"],
      "versionArgs": ["--version"]
    }
  },
  "thresholds": {
    "poor": 2.5,
    "secondarySampleRate": 0.2
  }
}
